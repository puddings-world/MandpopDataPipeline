# Dataset directory (default: wherever you cloned this repo)
# Leave as "." if pipeline.py is inside the dataset directory.
DATASET_PATH=.

# Google Doc tracked by `pipeline.py ingest --from-doc` (overrides the link
# saved in inbox_config.json). Must be shared as "anyone with the link can view".
# NOTES_DOC_URL=https://docs.google.com/document/d/<doc-id>/edit

# `pipeline.py inbox`: shell command run after each successful ingest,
# e.g. push new setlist songs to the performer's phone (consumer repo).
# INBOX_POST_INGEST_CMD=cd /d C:\path\to\StreetPerformerMaster && .venv\Scripts\python.exe sync_to_android.py
